# --- Servidor ---
PORT=3000
# URL pública donde queda corriendo este servidor (Render, Railway, ngrok, etc.). Sin "/" al final.
PUBLIC_URL=https://tu-servidor.com
# Clave secreta que protege los webhooks y el envío del bot. Inventa una larga.
APP_SECRET=pon-aqui-una-clave-larga

# --- Personalización ---
HUMAN_NAME=Nicolás
BOT_NAME=Asistente Agrak
COMPANY_NAME=Agrak

# --- Recall.ai (bot que entra al Meet) ---
RECALL_API_KEY=
RECALL_REGION=us-west-2
# camera = se ve en el recuadro del bot | screenshare = se ve como pantalla compartida (más grande)
RECALL_OUTPUT_SLOT=camera
# Transcripción en español en tiempo real vía Deepgram.
# La llave de Deepgram NO va aquí: se carga en el dashboard de Recall (Transcription > Deepgram).
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_TURN_MODEL=claude-haiku-5-5
CLAUDE_SUMMARY_MODEL=claude-sonnet-5-5

# --- Voz ---
# elevenlabs | openai | none
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=ash

# --- Resumen al terminar (opcional) ---
# Se envía un POST con el resumen en JSON a esta URL (ej. tu flujo de WhatsApp, n8n, Make, Zapier).
SUMMARY_WEBHOOK_URL=

# --- Tiempos (ms), opcionales ---
# PAUSE_AFTER_TALK_MS=1500
# ANSWER_TIMEOUT_MS=20000
# QA_SILENCE_MS=25000
